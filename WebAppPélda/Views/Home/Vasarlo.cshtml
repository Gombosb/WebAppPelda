@{
    ViewData["Title"] = "Sajat oldal";
}
<div>
    <h1 class="display-4" >Saját oldal</h1>
    <p>Model.ToString()</p>
    <p>Vásárló id: @Model.Id</p>
    <p>Vásárló neve: @Model.Name</p>
    <p>Vásárló Címe: @Model.Cim</p>
    <p>Vásárló Emailje: @Model.Email</p>
    <p>Vásárló telefonszáma: @Model.Telefon</p>
    <p>Vásárló pontszáma: @Model.Pontszam</p>
</div>
